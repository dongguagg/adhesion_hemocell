<?xml version="1.0" ?>
<hemocell>

<parameters>
    <warmup>0</warmup> <!-- Cell-free LBM warm-up iterations. -->
    <outputDirectory>output</outputDirectory>
    <checkpointDirectory>checkpoint</checkpointDirectory>
    <logDirectory>log</logDirectory>
    <logFile>twoCellShear.log</logFile>
</parameters>

<ibm>
    <radius>3.91e-6</radius> <!-- RBC radius in m. -->
    <stepMaterialEvery>1</stepMaterialEvery>
    <stepParticleEvery>1</stepParticleEvery>
</ibm>

<domain>
    <!-- Nominal physical box dimensions in micrometers. -->
    <Lx>30.0</Lx>
    <Ly>20.0</Ly>
    <Lz>20.0</Lz>
    <shearrate>100.0</shearrate> <!-- Target shear rate in s^-1. -->
    <rhoP>1025</rhoP>            <!-- Fluid density in kg/m^3. -->
    <nuP>1.1e-6</nuP>            <!-- Fluid kinematic viscosity in m^2/s. -->
    <dx>0.5e-6</dx>              <!-- Physical length of one lattice unit in m. -->
    <dt>0.5e-7</dt>              <!-- Physical duration of one time step in s. -->
    <fluidEnvelope>2</fluidEnvelope>
    <particleEnvelope>20</particleEnvelope>
    <kBT>4.100531391e-21</kBT>   <!-- Thermal energy in J at 300 K. -->
</domain>

<decomposition>
    <!-- MPI process grid used by the regular lattice decomposition. -->
    <nprocX>3</nprocX>
    <nprocY>2</nprocY>
    <nprocZ>2</nprocZ>
</decomposition>

<cellCellAdhesion>
    <r0>0.2</r0>                 <!-- LJ/Morse transition distance in um. -->
    <rc>1.0</rc>                 <!-- Adhesion cutoff distance in um. -->
    <!-- Tuning values: epsilon=5 kBT for LJ repulsion, D0=10 kBT for adhesion. -->
    <epsilon>4.100531391e-22</epsilon> <!-- LJ energy scale in J. -->
    <D0>4.100531391e-21</D0>           <!-- Morse well depth in J. -->
    <alpha>3.0</alpha>                 <!-- Morse width parameter in um^-1. -->
</cellCellAdhesion>

<cellWallAdhesion>
    <r0>0.45</r0>                 <!-- LJ/Morse transition distance in um. -->
    <rc>1.0</rc>                 <!-- Adhesion cutoff distance in um. -->
    <!-- Initial wall-anchor values: epsilon=10 kBT and D0=20 kBT. -->
    <epsilon>2.050265696e-20</epsilon> <!-- LJ energy scale in J. -->
    <D0>8.201062782e-20</D0>           <!-- Morse well depth in J. -->
    <alpha>4.0</alpha>                 <!-- Morse width parameter in um^-1. -->
</cellWallAdhesion>

<sim>
    <!-- Initial staging baseline; tmax includes relaxation and velocity ramp. -->
    <tRelax>50000</tRelax>
    <tRamp>0</tRamp>
    <tmax>1000000</tmax>
    <tmeas>10000</tmeas>
    <tcheckpoint>50000</tcheckpoint>
</sim>

</hemocell>
